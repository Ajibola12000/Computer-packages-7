# Approximate the square root of x1 using bisection search
x1 = 25
epsilon = 0.01
if x1 < 0:
    print('Does not exist')  # Cannot compute square root of a negative number
else:
    low = 0
    high = max(1, x1)
    ans = (high + low) / 2
    while abs(ans**2 - x1) >= epsilon:  # Loop until the squared guess is close enough to x1
        if ans**2 < x1:
            low = ans
        else:
            high = ans
        ans = (high + low) / 2
x1_root = ans  # Final approximation of square root

# Approximate the cube root of x2 using bisection search
x2 = -8
if x2 < 0:
    is_pos = False  # Track original sign of the number
    x2 = -x2  # Work with the positive equivalent
else:
    is_pos = True
low = 0
high = max(1, x2)
ans = (high + low) / 2
while abs(ans**3 - x2) >= epsilon:  # Loop until the cubed guess is close enough to x2
    if ans**3 < x2:
        low = ans
    else:
        high = ans
    ans = (high + low) / 2
if is_pos:
    x2_root = ans  # Cube root for positive numbers
else:
    x2_root = -ans  # Restore original sign for negative input
    x2 = -x2
print('Sum of square root of', x1, 'and cube root of', x2, 'is close to', x1_root + x2_root)

# Determine the larger of two values
def max_val(x, y):
    # Return the maximum between x and y
    if x > y:
        return x
    else:
        return y

# Approximate the power-root of x using bisection search
def find_root(x, power, epsilon):
    # Return a value y such that y**power is within epsilon of x
    # Return None if no real root exists (e.g., even root of a negative number)
    if x < 0 and power % 2 == 0:
        return None
    low = min(-1, x)
    high = max(1, x)
    ans = (high + low) / 2
    while abs(ans**power - x) >= epsilon:  # Loop until guess^power is close enough to x
        if ans**power < x:
            low = ans
        else:
            high = ans
        ans = (high + low) / 2
    return ans

# Run tests on find_root for various values
def test_find_root(xvals, powers, epsilons):
    # Print the result of find_root for combinations of inputs
    for x in xvals:
        for p in powers:
            for e in epsilons:
                result = find_root(x, p, e)
                if result == None:
                    val = 'No root exists'  # Invalid input for root calculation
                else:
                    val = 'Okay'
                    if abs(result**p - x) > e:  # Check if result meets accuracy requirement
                        val = 'Bad'
                print(f'x = {x}, power = {p}, epsilon = {e}: {val}')

# Sample inputs for root testing
x_vals = (0.25, 8, -8)
powers = (1, 2, 3)
epsilons = (0.1, 0.001, 1)
test_find_root(x_vals, powers, epsilons)

# Helper function to get bounds for root-finding
def find_root_bound(x, power):
    """Return a search interval [low, high] for bisection"""
    low = min(-1, x)
    high = max(1, x)
    return low, high

# Perform bisection search to find root within bounds
def bisection_solve(x, power, epsilon, low, high):
    """Apply bisection method to approximate root of x"""
    ans = (high + low) / 2
    while abs(ans**power - x) >= epsilon:  # Continue refining guess
        if ans**power < x:
            low = ans
        else:
            high = ans
        ans = (high + low) / 2
    return ans

# Find root using modular functions
def find_root(x, power, epsilon):
    """Main function to find root using helper modules"""
    if x < 0 and power % 2 == 0:
        return None  # No real root for negative base with even power
    low, high = find_root_bound(x, power)
    return bisection_solve(x, power, epsilon, low, high)

# Iteratively calculate factorial
def fact_iter(n):
    """Return n! using iteration"""
    result = 1
    for i in range(1, n + 1):
        result *= i
    return result

# Recursively calculate factorial
def fact_rec(n):
    """Return n! using recursion"""
    if n == 1:
        return n
    else:
        return n * fact_rec(n - 1)

# Recursively compute nth Fibonacci number
def fib(n):
    """Return nth Fibonacci number using recursion"""
    if n == 0 or n == 1:
        return 1
    else:
        return fib(n - 1) + fib(n - 2)

# Test Fibonacci function for values 0 to n
def test_fib(n):
    """Print Fibonacci numbers from 0 to n"""
    for i in range(n + 1):
        print('fib of', i, '=', fib(i))

test_fib(14)

# Determine if a string is a palindrome
def is_palindrome(s):
    """Check if a string is a palindrome, ignoring case and non-letter characters"""
    def to_chars(s):
        """Convert string to lowercase and keep only letters"""
        s = s.lower()
        letters = ""
        for c in s:
            if c in 'abcdefghijklmnopqrstuvwxyz':
                letters = letters + c
        return letters
    def is_pal(s):
        """Recursively check if string is a palindrome"""
        if len(s) <= 1:
            return True
        else:
            return s[0] == s[-1] and is_pal(s[1:-1])
    return is_pal(to_chars(s))

print(is_palindrome('Able was I ere I saw Elba'))  # True
print(is_palindrome('Able was I ere I saw Atlanta'))  # False

